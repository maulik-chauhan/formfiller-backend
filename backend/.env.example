# ---- Core ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gov_forms
DB_ECHO=false

# ---- Cryptography (CHANGE ALL IN PRODUCTION; keys MUST be distinct) ----
# Keep blind-index, OTP and JWT signing keys separate from one another.
BLIND_INDEX_HMAC_KEY=change-me-blind-index
BLIND_INDEX_KEY_VERSION=1
OTP_HMAC_KEY=change-me-otp
IP_SUBNET_HASH_KEY=change-me-ip-subnet

# ---- Access JWT (EdDSA / Ed25519) ----
# ACCESS_JWT_ED25519_SEED_B64 is a base64-encoded 32-byte private seed. Generate
# with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Leave empty ONLY in development (an ephemeral key is generated per process).
JWT_ISSUER=https://api.govforms.in
ACCESS_JWT_ED25519_SEED_B64=
ACCESS_JWT_KID=ed25519-access-2026-v1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Entitlement Lease Token (ELT) Ed25519 signing key (base64 32-byte seed).
# Empty => ephemeral dev key. The previous key keeps already-issued ELTs
# verifiable across a rotation (set both prev vars when rotating).
LEASE_SIGNING_SEED_B64=
LEASE_SIGNING_KEY_ID=ed25519-elt-2026-v1
LEASE_SIGNING_PREV_SEED_B64=
LEASE_SIGNING_PREV_KEY_ID=

# ---- Template publisher signing (EdDSA / Ed25519) ----
# Signs published template bundles (v2 digest). Base64 32-byte seed. Empty => an
# ephemeral key per process, allowed ONLY in local development: staging and
# production refuse to start without a stable seed, and the access-token, lease and
# template seeds must all differ. The matching PUBLIC key is pinned in the frontend
# build (DEC-1); /templates/publisher-keys is a distribution hint, never a trust anchor.
TEMPLATE_SIGNING_ED25519_SEED_B64=
TEMPLATE_SIGNING_KEY_ID=ed25519-template-2026-v1
# Rotation only: the previous key keeps already-published signatures verifiable.
# Set BOTH or neither. Remove them to retire (revoke) the old key.
TEMPLATE_SIGNING_PREV_SEED_B64=
TEMPLATE_SIGNING_PREV_KEY_ID=

# ---- Template blank-PDF storage / CDN (DEC-3 pending) ----
# local       = filesystem + static CDN base URL (development; production adapter TBD)
# mock_signed = HMAC-signed expiring URLs, TESTS ONLY (rejected in production)
TEMPLATE_STORAGE_PROVIDER=local
TEMPLATE_STORAGE_DIR=/tmp/govforms_templates
# Clients pin this host and the path /blank_pdfs/<sha256>.pdf.
TEMPLATE_CDN_BASE_URL=https://cdn.govforms.in
TEMPLATE_DOWNLOAD_URL_TTL_SECONDS=900

# ---- CORS ----
# Comma-separated exact browser origins. Empty => no CORS headers. Credentials are
# never allowed. Production requires https origins and rejects wildcards.
# Development example: http://localhost:8080,http://127.0.0.1:8080
CORS_ALLOWED_ORIGINS=

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX_PER_HOUR=5
OTP_VERIFY_MAX_PER_MINUTE_PER_IP=5
# OTP delivery: mock (dev/tests) | console (dev logs) | sms (production)
OTP_DELIVERY_PROVIDER=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_SENDER_ID=

# ---- Commercial (PROVISIONAL — pending product-owner sign-off) ----
# COM-01: lifetime free quota is NOT finally approved. Leave UNSET to grant zero
# free credits (safe default). Set to an integer (e.g. 2) only once approved.
# DEFAULT_FREE_QUOTA_TOTAL=
LEASE_RESERVATION_TTL_HOURS=48
LEASE_CORRECTION_WINDOW_HOURS=24

# ---- Retention windows (subject to legal review) ----
DELETED_QUOTA_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=1095
AUDIT_IP_HASH_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=90
OTP_CHALLENGE_RETENTION_DAYS=7
FINANCIAL_LEDGER_RETENTION_DAYS=2920

# ---- Payments (Razorpay) ----
# Secrets must never be committed or logged. Test mode (fake gateway) is the
# local default; production requires real credentials and RAZORPAY_ENVIRONMENT=live.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_ENVIRONMENT=test
RAZORPAY_API_BASE=https://api.razorpay.com/v1
# Gateway network mode: fake (dev/tests) | http (real API) | auto (http in prod w/ creds)
RAZORPAY_GATEWAY_MODE=auto
RAZORPAY_HTTP_TIMEOUT_SECONDS=15
# payment_orders.quantity is fixed at 1 by the DB; this bounds the accepted value.
PAYMENT_MAX_QUANTITY=1

# ---- Module gating ----
ESIGN_MODULE_ENABLED=false
