# ---- Core ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gov_forms
DB_ECHO=false

# ---- Cryptography (CHANGE ALL IN PRODUCTION; keys MUST be distinct) ----
# Keep blind-index, OTP and JWT signing keys separate from one another.
BLIND_INDEX_HMAC_KEY=change-me-blind-index
BLIND_INDEX_KEY_VERSION=1
OTP_HMAC_KEY=change-me-otp
IP_SUBNET_HASH_KEY=change-me-ip-subnet

# ---- Access JWT (EdDSA / Ed25519) ----
# ACCESS_JWT_ED25519_SEED_B64 is a base64-encoded 32-byte private seed. Generate
# with: python -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
# Leave empty ONLY in development (an ephemeral key is generated per process).
JWT_ISSUER=https://api.govforms.in
ACCESS_JWT_ED25519_SEED_B64=
ACCESS_JWT_KID=ed25519-access-2026-v1
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
# Entitlement Lease Token (ELT) Ed25519 signing key (base64 32-byte seed).
# Empty => ephemeral dev key. The previous key keeps already-issued ELTs
# verifiable across a rotation (set both prev vars when rotating).
LEASE_SIGNING_SEED_B64=
LEASE_SIGNING_KEY_ID=ed25519-elt-2026-v1
LEASE_SIGNING_PREV_SEED_B64=
LEASE_SIGNING_PREV_KEY_ID=

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60
OTP_REQUEST_MAX_PER_HOUR=5
OTP_VERIFY_MAX_PER_MINUTE_PER_IP=5
# OTP delivery: mock (dev/tests) | console (dev logs) | sms (production)
OTP_DELIVERY_PROVIDER=mock
SMS_PROVIDER_API_KEY=
SMS_PROVIDER_API_SECRET=
SMS_PROVIDER_SENDER_ID=

# ---- Commercial (PROVISIONAL — pending product-owner sign-off) ----
# COM-01: lifetime free quota is NOT finally approved. Leave UNSET to grant zero
# free credits (safe default). Set to an integer (e.g. 2) only once approved.
# DEFAULT_FREE_QUOTA_TOTAL=
LEASE_RESERVATION_TTL_HOURS=48
LEASE_CORRECTION_WINDOW_HOURS=24

# ---- Retention windows (subject to legal review) ----
DELETED_QUOTA_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=1095
AUDIT_IP_HASH_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=90
OTP_CHALLENGE_RETENTION_DAYS=7
FINANCIAL_LEDGER_RETENTION_DAYS=2920

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Module gating ----
ESIGN_MODULE_ENABLED=false
