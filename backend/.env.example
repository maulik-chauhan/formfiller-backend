# ---- Core ----
ENVIRONMENT=development
DEBUG=true
API_V1_PREFIX=/api/v1

# ---- Database ----
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/gov_forms
DB_ECHO=false

# ---- Cryptography (CHANGE ALL IN PRODUCTION) ----
BLIND_INDEX_HMAC_KEY=change-me-blind-index
BLIND_INDEX_KEY_VERSION=1
OTP_HMAC_KEY=change-me-otp
IP_SUBNET_HASH_KEY=change-me-ip-subnet
JWT_SECRET_KEY=change-me-jwt
JWT_ALGORITHM=HS256
ACCESS_TOKEN_TTL_MINUTES=15
REFRESH_TOKEN_TTL_DAYS=30
LEASE_SIGNING_SEED_B64=
LEASE_SIGNING_KEY_ID=dev-lease-key-1

# ---- OTP ----
OTP_TTL_SECONDS=300
OTP_MAX_ATTEMPTS=3
OTP_RESEND_COOLDOWN_SECONDS=60

# ---- Commercial (PROVISIONAL — pending product-owner sign-off) ----
DEFAULT_FREE_QUOTA_TOTAL=2
LEASE_RESERVATION_TTL_HOURS=48
LEASE_CORRECTION_WINDOW_HOURS=24

# ---- Retention windows (subject to legal review) ----
DELETED_QUOTA_RETENTION_DAYS=730
AUDIT_LOG_RETENTION_DAYS=1095
AUDIT_IP_HASH_RETENTION_DAYS=90
WEBHOOK_EVENT_RETENTION_DAYS=90
OTP_CHALLENGE_RETENTION_DAYS=7
FINANCIAL_LEDGER_RETENTION_DAYS=2920

# ---- Payments ----
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---- Module gating ----
ESIGN_MODULE_ENABLED=false
